{
  "name": "lgtmhub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @lgtmhub/web dev",
    "build": "pnpm --filter @lgtmhub/web build",
    "start": "pnpm --filter @lgtmhub/web start",
    "prepare": "lefthook install",
    "lint": "biome lint .",
    "lint:md": "markdownlint-cli2",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "pnpm --filter @lgtmhub/web typecheck",
    "test": "pnpm --filter @lgtmhub/web test",
    "test:unit": "pnpm --filter @lgtmhub/web test:unit",
    "test:integration": "pnpm --filter @lgtmhub/web test:integration",
    "test:e2e": "pnpm --filter @lgtmhub/web test:e2e",
    "test:coverage": "pnpm --filter @lgtmhub/web test:coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:nuke": "supabase stop --no-backup",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "danger": "^14.0.0",
    "lefthook": "^2.1.6",
    "markdownlint-cli2": "^0.24.0",
    "supabase": "^2.0.0"
  }
}
