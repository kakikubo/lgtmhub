{
  // markdownlint-cli2 の設定。CI（pnpm run lint:md）と CodeRabbit の
  // 両方がこのファイルを読むため、ルールの正はここ 1 箇所とする。
  //
  // 方針: MD040（コードフェンスの言語指定）を軸にした最小構成。
  // 現状の docs/ で違反が無いルールはデフォルトのまま有効にし、
  // 既存ドキュメントの書式と合わないルールのみ理由付きで無効化する。
  // 無効化したもののうち自動修正可能なものは、書式の一括整形という
  // 別の関心事として、別 PR で有効化を検討する。
  "globs": ["docs/**/*.md"],
  "config": {
    "default": true,

    // MD013（行長）: docs/ は 4792 行中 264 行が 80 文字超、最長は
    // development-guidelines.md の 612 文字。大半が日本語の散文で、
    // 機械的に折り返すと可読性を損なうため無効化する。
    "MD013": false,

    // MD060（テーブルのパイプ前後のスペース）: 違反 230 件。docs/ の表は
    // 列幅を詰めた記法で統一されており、既存の書式を全面的に書き換える
    // ことになるため無効化する。
    "MD060": false,

    // MD032（リストの前後の空行）: 違反 104 件。見出し直後や説明行直後に
    // 空行なしでリストを続ける書き方が docs/ 全体で一貫しているため無効化する。
    "MD032": false,

    // MD031（コードフェンスの前後の空行）: 違反 30 件。上記 MD032 と同じく
    // 既存の書式に合わないため無効化する。
    "MD031": false,

    // MD022（見出しの前後の空行）: 違反 18 件。同上。
    "MD022": false,

    // MD058（テーブルの前後の空行）: 違反 4 件。同上。
    "MD058": false,

    // MD012（連続する空行）: 違反 3 件。区切りとして意図的に 2 行空けている
    // 箇所があるため無効化する。
    "MD012": false,

    // MD028（引用ブロック内の空行）: 違反 1 件。product-requirements.md で
    // 引用を空行で区切る書き方をしているため無効化する。
    "MD028": false,

    // MD034（裸の URL）: 違反 11 件。glossary.md の「公式サイト」欄などで
    // URL をそのまま書いており、GitHub 側で自動リンクされるため実害がない。
    "MD034": false,

    // MD024（重複見出し）: functional-design.md の「目的」「処理フロー」は
    // 異なる親見出し配下の兄弟セクションで、重複していて問題ない。
    // 完全無効化はせず、同一階層内の重複のみを禁止する。
    "MD024": { "siblings_only": true }
  }
}
